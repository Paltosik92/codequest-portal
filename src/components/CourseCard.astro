---
import type { Course } from '../data/courses';
import { courseUrl } from '../lib/paths';
import CourseCover from './CourseCover.astro';
import Icon from './Icon.astro';
interface Props { course: Course; index: number; }
const { course, index } = Astro.props;
---
<a class="course-card" href={courseUrl(course.id)} style={`--course-accent:${course.accent}`}>
  <div class="card-windowbar" aria-hidden="true"><span>КВЕСТ / 0{index + 1}</span><span>■ ■ ×</span></div>
  <CourseCover course={course}/>
  <div class="card-content"><div class="card-overline"><span>{course.category}</span><span class="card-number">0{index + 1}</span></div>
  <h3>{course.title}<span class="card-arrow"><Icon name="arrow"/></span></h3>
  <p>{course.description}</p><div class="tags">{course.technologies.map(t => <span>{t}</span>)}</div></div>
</a>
