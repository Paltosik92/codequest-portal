---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/pixel.css';
import pixelFont from '../assets/fonts/codequest-pixel.ttf?url';
import '../styles/learning.css';
import '../styles/reading.css';
import '../styles/code-windows.css';
import '../styles/course-map.css';
import '../styles/offline.css';
import '../styles/lesson-navigation.css';
import { getLearningCatalog } from '../lib/learning-catalog';
const learningCatalog = await getLearningCatalog();
import { url } from '../lib/paths';
interface Props { title?: string; description?: string; current?: string; }
const { title = 'CodeQuest — от первой строки кода до собственного проекта', description = 'Личная библиотека практических курсов: игры, мобильные, настольные и веб-приложения. Учись программировать, создавая собственные проекты.', current } = Astro.props;
---
<!doctype html>
<html lang="ru" data-theme="dark">
  <head>
    <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="description" content={description}/><meta name="color-scheme" content="dark light"/>
    <meta name="theme-color" content="#101526"/>
    <link rel="preload" href={pixelFont} as="font" type="font/ttf" crossorigin/>
    <meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')}/>
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}/>}
    <title>{title}</title>
    <script is:inline>
      try { document.documentElement.dataset.theme = localStorage.getItem('codequest-theme') === 'light' ? 'light' : 'dark'; } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти к содержанию</a>
    <Header current={current}/>
    <div class="container"><p id="learning-storage-status" class="storage-note" role="status" hidden></p></div>
    <main id="main"><slot /></main>
    <Footer/>
    <script type="application/json" id="learning-catalog" set:html={JSON.stringify(learningCatalog).replace(/</g, '\\u003c')}/>
    <script src="../scripts/learning.ts"></script>
    <script src="../scripts/offline.ts"></script>
    <span id="bookmark-status" class="sr-only" role="status" aria-live="polite"></span>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
      function updateThemeLabel() {
        const light = document.documentElement.dataset.theme === 'light';
        toggle?.setAttribute('aria-label', light ? 'Включить тёмную тему' : 'Включить светлую тему');
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', light ? '#f4f1e3' : '#101526');
      }
      if (toggle) {
        toggle.hidden = false;
        updateThemeLabel();
        toggle.addEventListener('click', () => {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem('codequest-theme', next); } catch {}
          updateThemeLabel();
        });
      }
    </script>
  </body>
</html>
