---
import BaseLayout from './BaseLayout.astro';
import CourseCover from '../components/CourseCover.astro';
import Icon from '../components/Icon.astro';
import ResumePanel from '../components/ResumePanel.astro';
import type { Course } from '../data/courses';
import { getPublishedLessons } from '../lib/lessons';
import { url, lessonUrl } from '../lib/paths';
interface Props { course: Course; }
const { course } = Astro.props;
const published = (await getPublishedLessons()).filter(l => l.data.courseId === course.id && !l.data.demo);
const groups = course.modules || [{ title: 'Программа курса', from: 0, to: Number.MAX_SAFE_INTEGER }];
const activeNumbers = new Set(published.map(l => l.data.number));
const lessons = [
  ...course.plannedLessons.map(l => ({ ...l, entry: published.find(p => p.data.number === l.number) })),
  ...published.filter(p => !course.plannedLessons.some(l => l.number === p.data.number)).map(p => ({ number: p.data.number!, title: p.data.title, entry: p })),
].sort((a, b) => a.number - b.number);
const plural = new Intl.PluralRules('ru').select(lessons.length);
const workLabel = plural === 'one' ? 'работа' : plural === 'few' ? 'работы' : 'работ';
const firstLesson = published[0];
const allPublished = lessons.length > 0 && lessons.every(lesson => lesson.entry);
---
<BaseLayout title={`${course.title} — CodeQuest`} description={course.description} current="courses">
  <div class="container course-page" style={`--course-accent:${course.accent}`}>
    <nav class="breadcrumbs" aria-label="Хлебные крошки"><a href={url()}>Главная</a><span>/</span><a href={url('#courses')}>Курсы</a><span>/</span><span aria-current="page">{course.title}</span></nav>
    <section class="course-intro"><div><div class="eyebrow">{course.category}</div><h1>{course.title}<span class="brand-dot">.</span></h1><p class="academic-title">{course.academicTitle}</p><p class="course-lead">{course.description}</p><div class="tags">{course.technologies.map(t => <span>{t}</span>)}</div><div class="course-actions"><a href={firstLesson ? lessonUrl(firstLesson.data.slug) : '#curriculum'} class="button button-primary">{firstLesson ? 'Открыть первую работу' : 'Смотреть программу'} <Icon name="arrow"/></a>{firstLesson ? <a class="text-link" href="#curriculum">Вся программа ↓</a> : <span>Проектное обучение<br/><strong>{course.project}</strong></span>}</div></div><CourseCover course={course} large/></section>
    <ResumePanel courseId={course.id}/><p class="course-progress-label" data-course-progress={course.id} hidden></p>
    <nav class="course-tabs" aria-label="На странице курса"><a href="#about">О курсе</a><a href="#outcomes">Чему научишься</a><a href="#curriculum">Программа</a></nav>
    <div class="course-body"><div class="course-main"><section class="course-section" id="about"><div class="eyebrow">ОТ ИДЕИ ДО ПРИЛОЖЕНИЯ</div><h2>Что будем создавать</h2><p>{course.intro}</p>{course.sourceNote && <p class="source-note">{course.sourceNote}</p>}</section>
    {course.downloads && <section class="course-section"><h2>Ресурсы проекта</h2>{course.downloads.map(resource => <div class="course-download"><h3>{resource.title}</h3><p>{resource.description}</p><a class="button button-outline" href={url(resource.path)} download>{resource.buttonLabel || 'Скачать архив'} <span aria-hidden="true">↓</span></a></div>)}</section>}
    <section class="course-section" id="outcomes"><h2>Чему научишься</h2><ul class="outcomes">{course.goals.map(goal => <li><span><Icon name="check" size={18}/></span>{goal}</li>)}</ul></section>
    <section class="course-section curriculum" id="curriculum"><div class="curriculum-title"><h2>Программа курса</h2><span>{lessons.length} {workLabel} в программе</span></div><div class="notice"><Icon name="book" size={24}/><p><strong>{allPublished ? 'Все работы доступны' : published.length ? 'Продолжай свой проект' : 'Знакомство с программой'}</strong>{published.length ? `Доступно: ${activeNumbers.size} из ${lessons.length}. Открывай работы по порядку: каждая продолжает предыдущую.` : 'Названия и номера взяты из учебных файлов. Полные методички пока не опубликованы.'}</p></div>
    {groups.map((group, index) => <details class="curriculum-module" open><summary><span>{course.modules && <span class="module-index">{String(index + 1).padStart(2, '0')}</span>}{group.title}</span><span aria-hidden="true">−</span></summary><ol class="lesson-list">{lessons.filter(l => l.number >= group.from && l.number <= group.to).map(lesson => <li><span class="lesson-number">{String(lesson.number).padStart(2, '0')}</span>{lesson.entry ? <a href={lessonUrl(lesson.entry.data.slug)}>{lesson.title}<span>Открыть работу ↗ <strong class="completion-mark" data-completion-mark={lesson.entry.data.slug} hidden>✓ Выполнено</strong></span></a> : <div><span>{lesson.title}</span><small>Материал ещё не подключён</small></div>}{lesson.entry ? <Icon name="arrow" size={18}/> : <span class="lesson-pending" aria-label="Не опубликовано">◷</span>}</li>)}</ol></details>)}
    </section></div><aside class="course-sidebar"><div class="sidebar-card"><span class="eyebrow">ТВОЙ ПРОЕКТ</span><h3>{course.project}</h3><p>Практика за практикой — от первой работающей версии до целого приложения.</p><div class="sidebar-separator"></div><span class="sidebar-label">Инструменты</span><div class="tags">{course.technologies.map(t => <span>{t}</span>)}</div><a class="text-link" href={firstLesson ? lessonUrl(firstLesson.data.slug) : '#curriculum'}>{firstLesson ? 'Начать с первой работы' : 'Смотреть программу'} <Icon name="arrow" size={17}/></a></div><p class="sidebar-note">Для переноса прогресса на другое устройство используй экспорт на странице «Прогресс».</p></aside></div>
    <a class="back-link text-link" href={url('#courses')}>← Вернуться к направлениям</a>
  </div>
</BaseLayout>
