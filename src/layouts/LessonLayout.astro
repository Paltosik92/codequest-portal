---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ReadingTools from '../components/ReadingTools.astro';
import OfflineLesson from '../components/OfflineLesson.astro';
import LessonToc from '../components/LessonToc.astro';
import LessonResources from '../components/LessonResources.astro';
import { publishedCourses } from '../data/courses';
import { lessonNavigation } from '../data/lesson-navigation';
import { url, courseUrl, lessonUrl } from '../lib/paths';
interface Props { lesson: CollectionEntry<'lessons'>; headings: MarkdownHeading[]; previous?: CollectionEntry<'lessons'>; next?: CollectionEntry<'lessons'>; }
const { lesson, headings, previous, next } = Astro.props;
const course = publishedCourses.find(c => c.id === lesson.data.courseId);
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
const navigation = lessonNavigation[lesson.data.slug];
const anchor = (title?: string) => {
  if (!title) return undefined;
  const found = headings.find(heading => heading.text === title);
  if (!found) throw new Error(`Не найден проверенный раздел ${title}: ${lesson.data.slug}`);
  return found.slug;
};
const task = anchor(navigation?.task) || 'lesson-article';
const submission = anchor(navigation?.submission);
const outcome = anchor(navigation?.outcome);
const showDescription = lesson.data.demo || !/^Практическая работа №/u.test(lesson.data.description);
---
<BaseLayout title={`${lesson.data.title} — CodeQuest`} description={lesson.data.description} current="courses">
  <div class="container lesson-page" data-reader-slug={lesson.data.demo ? undefined : lesson.data.slug}>
    <nav class="breadcrumbs" aria-label="Хлебные крошки"><a href={url()}>Главная</a><span>/</span>{course && <><a href={courseUrl(course.id)}>{course.title}</a><span>/</span></>}<span aria-current="page">{`Работа №${lesson.data.number}`}</span></nav>
    <header class="lesson-header">
      <div class="eyebrow"><Icon name="book" size={15}/> {course?.title} · Работа №{lesson.data.number}</div>
      <h1>{lesson.data.title}</h1>
      {showDescription && <p>{lesson.data.description}</p>}
      <nav class="lesson-actions" aria-label="Быстрые переходы работы">
        <a class="button button-primary" href={`#${task}`} data-article-jump>К заданию ↓</a>
        {submission && <a class="text-link" href={`#${submission}`} data-article-jump>Что сдавать</a>}
        {outcome && <a class="text-link" href={`#${outcome}`} data-article-jump>Результат</a>}
        <a class="text-link" href="#lesson-toc" data-toc-jump>Содержание</a>
        <a class="text-link" href="#lesson-article" data-article-jump data-reading-start>С начала</a>
      </nav>
    </header>
    {!lesson.data.demo && <><div class="lesson-tools-row"><ReadingTools/><OfflineLesson slug={lesson.data.slug}/></div><div class="lesson-learning"><button class="button button-outline" type="button" data-lesson-complete aria-pressed="false" hidden>Отметить выполненной</button><span id="completion-status" role="status" aria-live="polite"></span></div></>}
    <div class="lesson-grid">
      <LessonToc headings={toc} back={course ? courseUrl(course.id) : url('#courses')}/>
      <div class="lesson-content">
        <LessonResources slug={lesson.data.slug} number={lesson.data.number}/>
        <article class="prose" id="lesson-article" tabindex="-1"><slot/></article>
        <a class="lesson-toc-return" href="#lesson-toc" data-toc-jump>↑ К содержанию работы</a>
        {!lesson.data.demo && <div class="lesson-learning"><button class="button button-primary" type="button" data-lesson-complete aria-pressed="false" hidden>Отметить выполненной</button>{submission && <a class="text-link" href={`#${submission}`}>Что сдавать →</a>}</div>}
        <nav class="lesson-pagination" aria-label="Соседние работы">
          {previous ? <a href={lessonUrl(previous.data.slug)}><span>← Предыдущая работа</span><strong>{previous.data.title}</strong></a> : <div aria-disabled="true"><span>← Предыдущая работа</span><strong>Начало курса</strong></div>}
          {next ? <a href={lessonUrl(next.data.slug)}><span>Следующая работа →</span><strong>{next.data.title}</strong></a> : <div aria-disabled="true"><span>Следующая работа →</span><strong>Следующая работа ещё не опубликована</strong></div>}
        </nav>
        <div class="lesson-bottom"><Icon name="code" size={18}/><span>Продолжай создавать. Шаг за шагом.</span><a href="#main">Наверх ↑</a></div>
      </div>
    </div>
  </div>
  <div class="image-dialog" role="dialog" aria-modal="true" aria-label="Просмотр иллюстрации" hidden><button type="button" class="image-close" aria-label="Закрыть иллюстрацию">×</button><img alt=""/><p></p></div>
  <span class="sr-only" role="status" id="copy-status" aria-live="polite"></span>
  <script src="../scripts/lesson.ts"></script>
  <script src="../scripts/lesson-navigation.ts"></script>
</BaseLayout>
